{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["reviewed_commit", "verdict", "summary", "findings"],
  "properties": {
    "reviewed_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "verdict": {
      "type": "string",
      "enum": ["clean", "needs_changes"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority", "title", "details", "location"],
        "properties": {
          "priority": {
            "type": "string",
            "enum": ["P0", "P1"]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string"
          }
        }
      }
    }
  }
}
